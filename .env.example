# Smart Agriculture Platform (SAP) — Backend Environment Configuration
PORT=8080

# Google Gemini API Key for AI Kisan Assistant Chatbot
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_actual_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenWeatherMap API Key (Optional — Open-Meteo is used as automatic fallback)
OWM_API_KEY=your_openweathermap_api_key_here
